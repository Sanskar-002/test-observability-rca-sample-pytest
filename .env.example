BROWSERSTACK_USERNAME=your-preprod-username
BROWSERSTACK_ACCESS_KEY=your-preprod-access-key
BROWSERSTACK_HUB_HOST=hub-preprod.bsstag.com
BROWSERSTACK_HUB_PORT=443
BROWSERSTACK_HUB_PATH=/wd/hub

BROWSERSTACK_LOCAL=false

# App URL the bad-pr-causation specs hit. On main/bad-automation-pr this is
# the clean Netlify deployment; on bad-dev-pr it is the broken one.
RCA_APP_URL=https://celadon-duckanoo-625c0b.netlify.app/

# Smart Test Selection: which feature branch this run represents
# BROWSERSTACK_ORCHESTRATION_SMART_SELECTION_FEATURE_BRANCHES={"RCA_SAMPLE_PYTEST":"bad-dev-pr"}
